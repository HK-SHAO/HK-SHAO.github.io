---
interface Props {
  eyebrow: string;
  title: string;
}

const { eyebrow, title } = Astro.props;
---

<header class="page-intro">
  <p class="eyebrow">{eyebrow}</p>
  <h1>{title}</h1>
  <slot />
</header>

<style>
  .page-intro { padding-block: var(--space-section) 0; }
  h1 { margin-bottom: 1rem; font-size: var(--text-page); font-weight: 600; letter-spacing: -0.04em; line-height: 1.05; }
</style>
