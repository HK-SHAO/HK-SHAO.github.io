---
import type { CollectionEntry } from "astro:content";
import ChipList from "./ChipList.astro";
import { RESERVED_TAGS } from "../utils/tags";
import Icon from "./Icon.astro";

interface Props {
  project: CollectionEntry<"entries">;
}

const { project } = Astro.props;
const { title, description, website, source, tags, publishedAt, updatedAt } = project.data;
const visibleTags = tags.filter((tag) => !RESERVED_TAGS.has(tag));
const displayDate = updatedAt ?? publishedAt;
const date = new Intl.DateTimeFormat("zh-CN", { year: "numeric", month: "2-digit" });
---

<article class="project-card">
  <a class="project-main" href={`/works/${project.id}/`}>
    <span>
      <h3>{title}</h3>
      <p>{description}</p>
    </span>
    <Icon name="arrow" />
  </a>
  <div class="project-meta">
    <span class="project-detail">
      {displayDate && <time datetime={displayDate.toISOString()}>{date.format(displayDate)} 更新</time>}
      {visibleTags.length > 0 && <ChipList items={visibleTags} label="技术标签" />}
    </span>
    <span class="project-actions">
      {website && <a href={website} target="_blank" rel="noreferrer">访问</a>}
      {source && <a href={source} target="_blank" rel="noreferrer">源码</a>}
    </span>
  </div>
</article>

<style>
  .project-card { border-bottom: 1px solid var(--line); }
  .project-main { display: grid; grid-template-columns: 1fr auto; align-items: start; gap: 1rem; padding-block: var(--space-row) var(--space-tight); color: var(--ink); }
  h3 { margin-bottom: 0.35rem; font-size: var(--text-heading); font-weight: 600; letter-spacing: -0.02em; }
  p { max-width: 40rem; margin-bottom: 0; color: var(--muted); }
  .project-main :global(svg) { margin-top: 0.25rem; color: var(--muted); transition: transform var(--duration-ui) var(--ease-out); }
  .project-meta { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; padding-bottom: var(--space-row); }
  .project-detail { display: flex; flex-wrap: wrap; align-items: center; gap: 0.55rem 0.75rem; min-width: 0; }
  time { flex: none; color: var(--muted); font-size: var(--text-xs); font-variant-numeric: tabular-nums; }
  .project-actions { display: flex; flex: none; gap: 0.75rem; font-size: var(--text-sm); }
  @media (hover: hover) and (pointer: fine) {
    .project-main:hover :global(svg) { color: var(--ink); transform: translate(0.15rem, -0.15rem); }
  }
  @media (min-width: 40.0625rem) {
    .project-main { gap: 2rem; }
    .project-meta { align-items: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .project-main :global(svg) { transition: color var(--duration-ui) var(--ease-out); }
    .project-main:hover :global(svg) { transform: none; }
  }
</style>
