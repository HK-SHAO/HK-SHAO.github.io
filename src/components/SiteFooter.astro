---
import { site } from "../site.config";
---

<footer class="site-footer">
  <div class="page-shell">
    <span>© {new Date().getFullYear()} {site.alias}</span>
    <a href={`https://icp.gov.moe/?keyword=${site.icp}`} target="_blank" rel="noreferrer">萌ICP备{site.icp}号</a>
    <span class="footer-links">
      <a href="/license/">License</a>
      <a href={site.profiles.github} target="_blank" rel="noreferrer">GitHub</a>
      <a href="/rss.xml">RSS</a>
    </span>
  </div>
</footer>

<style>
  .site-footer { padding-block: var(--space-panel) calc(var(--space-panel) + env(safe-area-inset-bottom, 0)); }
  .site-footer > div { display: flex; flex-direction: column; align-items: center; gap: 1rem; padding-top: 1.5rem; border-top: 1px solid var(--line); color: var(--muted); font-size: var(--text-xs); font-variant-numeric: lining-nums tabular-nums; }
  .footer-links { display: flex; gap: 1rem; }
  @media (min-width: 28rem) {
    .site-footer > div { flex-direction: row; flex-wrap: wrap; gap: 0.75rem 1rem; }
    .footer-links { margin-inline-start: auto; }
  }
</style>
