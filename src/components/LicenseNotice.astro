---
interface Props {
  content: string;
  code: string;
}

const { content, code } = Astro.props;
---

<aside class="license-notice" aria-label="版权说明">
  <strong>版权说明</strong>
  <p>
    除非另有说明，正文采用
    <a href="https://creativecommons.org/licenses/by-sa/4.0/deed.zh-hans" target="_blank" rel="license noreferrer">{content}</a>，
    代码采用 <a href="https://opensource.org/license/mit" target="_blank" rel="license noreferrer">{code}</a>。
  </p>
</aside>

<style>
  .license-notice { margin-top: 4rem; padding-top: 1.5rem; border-top: 1px solid var(--line); color: var(--muted); font-size: var(--text-sm); }
  strong { color: var(--ink); }
  p { margin: 0.35rem 0 0; }
  a { text-decoration: underline; text-underline-offset: 0.16em; }
</style>
