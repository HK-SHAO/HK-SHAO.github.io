---
import { site } from "../site.config";
---

{
  import.meta.env.PROD && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${site.analytics}`} />
      <script
        is:inline
        set:html={`window.dataLayer = window.dataLayer || []; function gtag() { dataLayer.push(arguments); } gtag("js", new Date()); gtag("config", "${site.analytics}");`}
      />
    </>
  )
}
