---
interface Props {
  bvid: string;
  page?: number;
}

const { bvid, page = 1 } = Astro.props;
const src = `https://player.bilibili.com/player.html?bvid=${bvid}&page=${page}&high_quality=1&danmaku=0&autoplay=0`;
---

<div class="bilibili-embed shape-squircle">
  <iframe
    src={src}
    title={`Bilibili 视频 ${bvid}`}
    allowfullscreen
    loading="lazy"
    referrerpolicy="no-referrer"
  ></iframe>
</div>

<style>
  .bilibili-embed { margin-block: 2rem; aspect-ratio: 16 / 9; border-radius: var(--radius); overflow: hidden; background: var(--surface); }
  iframe { display: block; width: 100%; height: 100%; border: 0; }
</style>
