---
interface Props {
  bvid: string;
  page?: number;
  title?: string;
}

const { bvid, page = 1, title = `Bilibili 视频 ${bvid}` } = Astro.props;
const src = `https://player.bilibili.com/player.html?bvid=${bvid}&p=${page}&high_quality=1&danmaku=0&autoplay=0`;
---

<div class="bilibili-embed shape-squircle">
  <iframe
    src={src}
    title={title}
    allowfullscreen
    loading="lazy"
    referrerpolicy="no-referrer"
  ></iframe>
</div>

<style>
  .bilibili-embed { margin-block: var(--bilibili-margin, 2rem); aspect-ratio: 16 / 9; border-radius: var(--radius, 0); overflow: hidden; background: var(--surface, #102820); }
  iframe { display: block; width: 100%; height: 100%; border: 0; }
</style>
