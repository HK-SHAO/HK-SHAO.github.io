---
interface Props {
  id?: string;
}

const { id } = Astro.props;
---

<div class="section-heading">
  <h2 id={id}><slot /></h2>
  <slot name="aside" />
</div>

<style>
  .section-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 2rem; }
  h2 { margin: 0; font-size: clamp(1.6rem, 6vw, 2.25rem); font-weight: 600; letter-spacing: -0.03em; }
  .section-heading > :global(:is(a, span)) { color: var(--muted); font-size: var(--text-sm); }
</style>
