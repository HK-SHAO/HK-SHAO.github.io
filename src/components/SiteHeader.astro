---
import { Image } from "astro:assets";
import { navigation } from "../site.config";
import avatar from "../assets/avatar.png";
import ThemeToggle from "./ThemeToggle.astro";

const pathname = Astro.url.pathname;
const isCurrent = (href: string) => href === "/" ? pathname === href : pathname.startsWith(href);
---

<header class="site-header">
  <div class="header-inner page-shell">
    <a class="brand" href="/" aria-label="烧风，返回首页">
      <Image src={avatar} width={36} height={36} densities={[1, 2, 3]} loading="eager" alt="" />
      <span>烧风</span>
    </a>
    <nav aria-label="主导航">
      {navigation.map((item) => (
        <a class:list={["pressable", "shape-round"]} href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a>
      ))}
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 10; padding-top: env(safe-area-inset-top, 0); background: linear-gradient(to bottom, var(--paper) -200%, transparent); }
  .site-header::before { content: ""; position: absolute; z-index: -1; inset: 0 0 auto 0; height: 200%; pointer-events: none; backdrop-filter: var(--blur); mask: linear-gradient(to bottom, black 25%, transparent); }
  @supports not (mask: linear-gradient(black, transparent)) {
    .site-header::before { height: 100%; background: linear-gradient(to bottom, var(--paper), transparent); }
  }
  .header-inner { display: grid; grid-template-columns: auto 1fr auto; align-items: center; min-height: var(--header-h); }
  .brand { display: inline-flex; align-items: center; justify-self: start; gap: 0.7rem; color: var(--ink); font-size: var(--text-ui); font-weight: 600; letter-spacing: 0.08em; }
  .brand :global(img) { width: 2rem; height: 2rem; border-radius: 50%; box-shadow: 0 0 0 1px var(--line); }
  .brand span { display: none; }
  nav { display: flex; justify-self: center; max-width: calc(100vw - 8rem); gap: 0; overflow-x: auto; scrollbar-width: none; }
  nav::-webkit-scrollbar { display: none; }
  nav a { display: inline-flex; flex: none; align-items: center; min-height: var(--tap); padding-inline: 0.5rem; border-radius: var(--radius-pill); color: var(--muted); font-size: var(--text-xs); font-weight: 560; }
  nav a[aria-current="page"] { background: var(--surface); color: var(--ink); box-shadow: inset 0 0 0 1px var(--line); }
  @media (hover: hover) and (pointer: fine) {
    nav a:hover { background: var(--surface); color: var(--ink); }
  }
  @media (min-width: 22.5625rem) {
    nav { gap: 0.25rem; }
    nav a { padding-inline: 0.65rem; font-size: var(--text-sm); }
  }
  @media (min-width: 40.0625rem) {
    .brand :global(img) { width: 2.25rem; height: 2.25rem; }
    nav { max-width: none; }
    nav a { padding-inline: 0.9rem; font-size: var(--text-sm); }
  }
  @media (min-width: 55.0625rem) {
    .header-inner { grid-template-columns: 1fr auto 1fr; }
    .brand span { display: inline; }
  }
  @media (prefers-reduced-transparency: reduce) {
    .site-header { background: var(--surface-solid); }
    .site-header::before { display: none; }
  }
</style>
