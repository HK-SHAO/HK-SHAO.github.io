---
import { Image } from "astro:assets";
import pool from "../../assets/voxpool/maps/pool.webp";
import backrooms from "../../assets/voxpool/maps/backrooms.webp";
import cornell from "../../assets/voxpool/maps/cornell.webp";
import oculus from "../../assets/voxpool/maps/oculus.webp";
import tide from "../../assets/voxpool/maps/tide.webp";
import ember from "../../assets/voxpool/maps/ember.webp";
import aeropolis from "../../assets/voxpool/maps/aeropolis.webp";
import reverie from "../../assets/voxpool/maps/reverie.webp";
import prism from "../../assets/voxpool/maps/prism.webp";

const maps = [
  { id: "pool", name: "泳池", image: pool, alt: "白瓷砖墙下的蓝色马赛克泳池", note: "一切开始的地方。" },
  { id: "tide", name: "潮汐浴殿", image: tide, alt: "白瓷砖拱顶下的长池，阳光在池底投出亮斑", note: "白瓷拱顶下的长池。" },
  { id: "oculus", name: "天光水院", image: oculus, alt: "阶梯状的屋顶开口露出云，下方是浅蓝水池", note: "抬头是一圈天窗。" },
  { id: "ember", name: "赤陶庭院", image: ember, alt: "红墙白梯围着十字形水池", note: "红墙，楼梯，连桥。" },
  { id: "aeropolis", name: "天空水城", image: aeropolis, alt: "白色门洞一层层排开，水渠从中间穿过，四周是云", note: "云边的水渠。" },
  { id: "reverie", name: "梦境回廊", image: reverie, alt: "青色和品红玻璃围成的回廊，色光落在水里", note: "彩色玻璃染过的光。" },
  { id: "prism", name: "棱镜水庭", image: prism, alt: "透明玻璃立在镜面台座上，周围是浅水和绿色小岛", note: "玻璃、镜子与小岛。" },
  { id: "backrooms", name: "后室", image: backrooms, alt: "黄色墙纸的走廊和一排顶灯", note: "跳下竖井就回不来。" },
  { id: "cornell", name: "康奈尔盒", image: cornell, alt: "红绿两面墙的方盒，底部是水，水的反光映满后墙", note: "红墙、绿墙、一池水。" },
];
---

<section class="maps vp-shell" id="maps" aria-labelledby="maps-title">
  <header class="vp-head">
    <h2 id="maps-title">九个地方</h2>
    <p>每张地图有自己的时刻，光总落在同一处。</p>
  </header>
  <ul role="list">
    {maps.map((map, index) => (
      <li id={`map-${map.id}`}>
        <Image src={map.image} alt={map.alt} widths={[400, 640, 960]} sizes="(min-width: 86rem) 25rem, (min-width: 40rem) 30vw, 92vw" format="webp" />
        <h3><span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>{map.name}</h3>
        <p>{map.note}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .maps { padding-block: var(--vp-space) 0; }
  ul { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.75rem 1.25rem; margin: 0; padding: 0; list-style: none; }
  li { scroll-margin-block-start: 1.5rem; }
  img { inline-size: 100%; block-size: auto; aspect-ratio: 16 / 9; object-fit: cover; background: #d5e7e3; }
  h3 { display: flex; align-items: baseline; gap: 0.6rem; margin-block-start: 0.7rem; font-size: 1.0625rem; font-weight: 700; }
  h3 span { color: var(--vp-accent); font-family: var(--vp-mono); font-size: 0.75rem; font-weight: 500; }
  li p { color: var(--vp-muted); font-size: 0.875rem; }

  @media (max-width: 40rem) {
    ul { grid-template-columns: minmax(0, 1fr); }
  }
</style>
