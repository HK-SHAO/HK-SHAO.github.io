---
import { voxpoolLinks } from "../../utils/voxpool-links";
---

<aside class="community" aria-label="VOXPOOL QQ 群">
  <div>
    <p class="community-title">QQ 群</p>
    <p class="community-note">晒地图卡，报问题。</p>
  </div>
  <div class="community-contact">
    <code>{voxpoolLinks.qqGroup}</code>
    <button type="button" data-copy={voxpoolLinks.qqGroup} hidden>复制</button>
    <span class="copy-status" role="status"></span>
  </div>
</aside>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    if (!navigator.clipboard) continue;
    button.hidden = false;
    button.addEventListener("click", async () => {
      const status = button.parentElement?.querySelector("[role='status']");
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? "");
        button.textContent = "已复制";
        if (status) status.textContent = "群号已复制";
      } catch {
        button.textContent = "请手动复制";
        if (status) status.textContent = "复制失败，请选中群号手动复制";
      }
    });
  }
</script>

<style>
  .community {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    padding-block: 1.25rem;
    border-block: 1px solid var(--vp-line, var(--line));
    color: var(--vp-ink, var(--ink));
  }

  .community-title { margin: 0; font-weight: 700; }
  .community-note { margin: 0.2rem 0 0; font-size: 0.875rem; color: var(--vp-muted, var(--muted)); }
  .community-contact { display: flex; align-items: center; gap: 0.9rem; }
  code { padding: 0; background: none; font-size: 1.125rem; color: inherit; user-select: all; font-variant-numeric: tabular-nums; }

  button {
    min-block-size: 2.75rem;
    min-inline-size: 5rem;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--vp-line, var(--line));
    border-radius: 0;
    background: transparent;
    color: var(--vp-accent, var(--accent));
    font: inherit;
    font-size: 0.875rem;
    font-weight: 650;
    cursor: pointer;
  }

  button[hidden] { display: none; }
  button:hover { border-color: currentColor; }
  .copy-status { position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); }
</style>
