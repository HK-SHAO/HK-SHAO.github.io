---
import { Image } from "astro:assets";
import VoxpoolLayout from "../../layouts/VoxpoolLayout.astro";
import MapGallery from "../../components/voxpool/MapGallery.astro";
import Community from "../../components/voxpool/Community.astro";
import Bilibili from "../../components/mdx/Bilibili.astro";
import hero from "../../assets/voxpool/hero.webp";
import light from "../../assets/voxpool/light.webp";
import card from "../../assets/voxpool/map-card.png";
import { voxpoolLinks as links } from "../../utils/voxpool-links";

const modes = [
  { name: "生存", verbs: "走 · 跳 · 游", note: "世界不变，只能捡起、放下或踢开物品。" },
  { name: "创造", verbs: "飞 · 拆 · 盖", note: "瓷砖、水、荧光石、彩色玻璃、镜子，随手取用。" },
];

const props = [
  { name: "黄鸭", note: "大、中、小" },
  { name: "海洋球", note: "八色，直径 10 厘米" },
  { name: "游泳圈", note: "四种浅色" },
  { name: "足球", note: "可以踢" },
];

const details = [
  { title: "键鼠", body: "WASD 移动，空格蓄力跳。创造模式按 F 飞行。" },
  { title: "触屏", body: "左侧摇杆，轻点放置，长按拆除。" },
  { title: "手柄", body: "标准手柄即插即用。" },
  { title: "画面", body: "默认 VHS 滤镜，可关。支持 HDR 与 P3。" },
  { title: "声音", body: "八音盒实时演奏 Gymnopédie No. 1，物理声学。" },
  { title: "设备", body: "支持 WebGPU 的浏览器，免安装。" },
];

const elsewhere = [
  { label: "B 站主页", note: "更新与录像", href: links.creator },
  { label: "爱发电", note: "支持开发", href: links.support },
  { label: "写信", note: "合作与展览", href: links.email },
];
---

<VoxpoolLayout
  title="VOXPOOL 体素池核"
  description="在浏览器里打开一座空泳池。九张地图，可以下水、往池里放一只黄鸭，或者一块一块改出自己的房间，再把整个世界存进一张图片。"
>
  <section class="hero" aria-labelledby="hero-title">
    <Image
      src={hero}
      alt="潮汐浴殿：白瓷砖拱顶下的长池，天窗的光在水底铺成一块亮斑"
      widths={[640, 960, 1440, 1920]}
      sizes="100vw"
      format="webp"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-copy vp-shell">
      <p class="kicker">体素池核 · VOXPOOL</p>
      <h1 id="hero-title">下水看看。</h1>
      <p class="lead">浏览器里的体素空间。下水，看光，动手改。</p>
      <div class="actions">
        <a class="primary" href={links.play}>在 B 站 Toy 打开 <span aria-hidden="true">↗</span></a>
        <a href={links.web}>网页版 <span aria-hidden="true">↗</span></a>
      </div>
      <p class="fine">需要 WebGPU · 键鼠、触屏、手柄</p>
    </div>
  </section>

  <MapGallery />

  <section class="modes vp-shell" aria-labelledby="modes-title">
    <header class="vp-head">
      <h2 id="modes-title">两种模式</h2>
      <p>新建世界时选定，自动存档。</p>
    </header>
    <div class="mode-grid">
      {modes.map(({ name, verbs, note }) => (
        <article>
          <h3>{name}</h3>
          <p class="verbs">{verbs}</p>
          <p>{note}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="props vp-shell" aria-labelledby="props-title">
    <header>
      <h2 id="props-title">水里的东西</h2>
      <p>真实大小，会浮会撞，有影子也有倒影。</p>
    </header>
    <dl>
      {props.map(({ name, note }) => (
        <div><dt>{name}</dt><dd>{note}</dd></div>
      ))}
    </dl>
  </section>

  <section class="card vp-shell" aria-labelledby="card-title">
    <figure>
      <Image src={card} alt="一张 VOXPOOL 地图卡：左上是潮汐浴殿的预览，其余三块是白、绿、蓝三色的编码方格" widths={[480, 720, 1024]} sizes="(min-width: 60rem) 34rem, 92vw" format="png" />
    </figure>
    <div class="card-copy">
      <h2 id="card-title">一张图，<br />一个世界</h2>
      <p>导出地图卡：左上是预览，其余三块就是整个世界。发给朋友，导入即达。缺一块也能读出，请发原图。</p>
      <p class="stat"><b>512</b><span>字节<br />整座潮汐浴殿</span></p>
    </div>
  </section>

  <section class="light" aria-labelledby="light-title">
    <Image src={light} alt="泳池一角，黄、青、品红三块玻璃把阳光染成色带，落在白瓷砖地上" widths={[640, 960, 1440, 1920]} sizes="(min-width: 60rem) 60vw, 100vw" format="webp" />
    <div class="light-copy">
      <h2 id="light-title">光线追踪</h2>
      <p>拆一块砖，屋子就暗一点。水面留下亮纹，玻璃染出颜色。</p>
      <a href={links.paper}>技术白皮书 <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="details vp-shell" aria-labelledby="details-title">
    <h2 id="details-title">上手</h2>
    <dl>
      {details.map(({ title, body }) => (
        <div><dt>{title}</dt><dd>{body}</dd></div>
      ))}
    </dl>
  </section>

  <section class="film vp-shell" aria-labelledby="film-title">
    <h2 id="film-title" class="sr-only">实机演示</h2>
    <Bilibili bvid={links.videoId} title="梦核泳池，被我装进浏览器" />
  </section>

  <section class="outro vp-shell" aria-labelledby="outro-title">
    <div class="outro-main">
      <h2 id="outro-title">池边见。</h2>
      <div class="actions">
        <a class="primary" href={links.play}>在 B 站 Toy 打开 <span aria-hidden="true">↗</span></a>
        <a href={links.web}>网页版 <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <ul role="list">
      {elsewhere.map(({ label, note, href }) => (
        <li><a href={href}><b>{label}</b><span>{note}</span><i aria-hidden="true">↗</i></a></li>
      ))}
    </ul>
    <div class="outro-community"><Community /></div>
  </section>
</VoxpoolLayout>

<style>
  h1, h2 { font-family: var(--vp-serif); font-weight: 800; letter-spacing: -0.06em; line-height: 1.1; text-wrap: balance; }
  h2 { font-size: clamp(2.2rem, 5vw, 3.8rem); }
  section { scroll-margin-block-start: 1.5rem; }
  img { inline-size: 100%; block-size: auto; }
  .sr-only { position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 1.5rem; }
  .actions a { display: inline-flex; align-items: center; gap: 0.5em; min-block-size: 3rem; font-weight: 700; }
  .primary { padding-inline: 1.25rem; background: var(--vp-ink); color: var(--vp-paper); text-decoration: none; }
  .primary:hover { background: var(--vp-accent); color: white; }

  .hero { position: relative; display: grid; min-block-size: min(calc(100svh - 4.25rem), 52rem); color: #f6f5ef; }
  .hero > img { position: absolute; inset: 0; block-size: 100%; object-fit: cover; object-position: 50% 60%; background: #9fb9b6; }
  .hero::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to top, rgb(9 31 27 / 0.85), rgb(9 31 27 / 0.4) 42%, rgb(9 31 27 / 0) 72%); }
  .hero-copy { position: relative; z-index: 1; display: grid; align-content: end; justify-items: start; gap: 1rem; padding-block: 4rem clamp(2.5rem, 6vw, 4.5rem); }
  .kicker { color: #b9e3d2; font-size: 0.8125rem; font-weight: 700; letter-spacing: 0.24em; }
  h1 { font-size: clamp(3.4rem, 11vw, 8.5rem); }
  .lead { font-size: clamp(1.1rem, 1.8vw, 1.35rem); text-wrap: balance; }
  p { text-wrap: pretty; }
  .fine { color: #c9d8d1; font-size: 0.8125rem; }
  .hero .primary { background: #f6f5ef; color: var(--vp-ink); }
  .hero .primary:hover { background: #c6e6d5; color: var(--vp-ink); }
  .hero a:hover { color: #c6e6d5; }
  .hero :focus-visible { outline-color: #c6e6d5; }

  .modes, .props, .card, .details, .film { padding-block-start: var(--vp-space); }

  .mode-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
  .mode-grid article { display: grid; align-content: start; gap: 0.5rem; padding: clamp(1.5rem, 3vw, 2.25rem); background: #e6ece4; border-block-start: 0.2rem solid var(--vp-accent); }
  .mode-grid h3 { font-family: var(--vp-serif); font-size: clamp(1.8rem, 3vw, 2.4rem); font-weight: 800; letter-spacing: -0.04em; }
  .verbs { color: var(--vp-accent); font-weight: 700; letter-spacing: 0.08em; }
  .mode-grid p:last-child { color: var(--vp-muted); }

  dl { margin: 0; }
  dt { font-weight: 700; }
  dd { margin: 0; color: var(--vp-muted); }

  .props { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 2rem clamp(2rem, 6vw, 6rem); align-items: end; }
  .props header { display: grid; gap: 0.75rem; }
  .props header p { color: var(--vp-muted); }
  .props dl > div { display: flex; justify-content: space-between; gap: 1rem; padding-block: 0.9rem; border-block-start: 1px solid var(--vp-line); }
  .props dl > div:last-child { border-block-end: 1px solid var(--vp-line); }

  .card { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 2rem clamp(2rem, 6vw, 6rem); align-items: center; }
  .card figure { max-inline-size: 34rem; }
  .card-copy { display: grid; gap: 1.25rem; justify-items: start; }
  .card-copy > p:not(.stat) { max-inline-size: 26rem; line-height: 1.8; }
  .stat { display: flex; align-items: center; gap: 0.9rem; padding-block-start: 1.25rem; border-block-start: 1px solid var(--vp-line); }
  .stat b { font-family: var(--vp-serif); font-size: clamp(3rem, 6vw, 4.5rem); font-weight: 800; letter-spacing: -0.05em; line-height: 1; color: var(--vp-accent); }
  .stat span { color: var(--vp-muted); font-size: 0.875rem; line-height: 1.5; }

  .light { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); margin-block-start: var(--vp-space); background: #16352f; color: #f3f2eb; }
  .light img { block-size: 100%; min-block-size: 22rem; object-fit: cover; }
  .light-copy { display: grid; align-content: center; justify-items: start; gap: 1rem; padding: clamp(2rem, 5vw, 4.5rem); }
  .light p { max-inline-size: 22rem; color: #d4e4da; line-height: 1.8; }
  .light a { display: inline-flex; align-items: center; gap: 0.4em; min-block-size: 2.75rem; font-weight: 700; }
  .light a:hover { color: #c6e6d5; }
  .light :focus-visible { outline-color: #c6e6d5; }

  .details { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 2rem clamp(2rem, 6vw, 6rem); }
  .details dl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 2rem; }
  .details dl > div { display: grid; gap: 0.35rem; padding-block: 1.1rem; border-block-start: 1px solid var(--vp-line); }

  .film { --bilibili-margin: 0; }

  .outro { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 2.5rem clamp(2rem, 6vw, 6rem); align-items: end; padding-block: var(--vp-space); }
  .outro-main { display: grid; gap: 1.5rem; }
  .outro h2 { font-size: clamp(2.8rem, 7vw, 5.5rem); }
  .outro ul { margin: 0; padding: 0; list-style: none; }
  .outro li { border-block-start: 1px solid var(--vp-line); }
  .outro li:last-child { border-block-end: 1px solid var(--vp-line); }
  .outro li a { display: grid; grid-template-columns: 6rem minmax(0, 1fr) auto; align-items: center; gap: 1rem; min-block-size: 3.5rem; text-decoration: none; }
  .outro li span { color: var(--vp-muted); font-size: 0.875rem; }
  .outro li i { font-style: normal; color: var(--vp-accent); }
  .outro li a:hover b { text-decoration: underline; }
  .outro-community { grid-column: 1 / -1; }

  @media (max-width: 60rem) {
    .props, .card, .details, .outro { grid-template-columns: minmax(0, 1fr); }
    .light { grid-template-columns: minmax(0, 1fr); }
    .light img { min-block-size: 0; aspect-ratio: 16 / 10; }
  }

  @media (max-width: 40rem) {
    .mode-grid, .details dl { grid-template-columns: minmax(0, 1fr); }
    .hero { min-block-size: min(calc(100svh - 4.25rem), 40rem); }
  }
</style>
