---
import { Image } from "astro:assets";
import VoxpoolLayout from "../../layouts/VoxpoolLayout.astro";
import sunlitPool from "../../assets/voxpool/sunlit-pool.jpg";
import dreamscape from "../../assets/voxpool/dreamscape.webp";
import backrooms from "../../assets/voxpool/backrooms.webp";
import doorway from "../../assets/voxpool/doorway.webp";
import skylight from "../../assets/voxpool/skylight.webp";
import tunnel from "../../assets/voxpool/tunnel.webp";
import Bilibili from "../../components/mdx/Bilibili.astro";
import { voxpoolLinks as links } from "../../utils/voxpool-links";

const scenes = [
  {
    id: "window",
    title: "穿过玻璃",
    image: doorway,
    alt: "三色玻璃把日光染成青、黄、品红，色带落在白瓷砖上",
    note: "隔着彩色玻璃，白瓷砖上多了几道色带。换一块玻璃，看看地上的颜色怎么变。",
  },
  {
    id: "surface",
    title: "从水下仰头",
    image: skylight,
    alt: "水下仰望十字形天窗，浅色波纹映在深蓝池壁",
    note: "抬头看天窗。水面折弯了光，池壁上游动的亮纹叫作焦散。",
  },
  {
    id: "tunnel",
    title: "游进通道",
    image: tunnel,
    alt: "透过晃动的水面看见被拉弯的瓷砖缝，水下通道深处一片幽暗",
    note: "瓷砖缝是直的。隔着水面看，缝线跟着波纹弯下去。",
  },
] as const;
---

<VoxpoolLayout
  title="VOXPOOL 体素池核 · 浏览器里的泳池与光"
  description="走进浏览器里的空泳池。潜到水下看光，换一块玻璃，搭自己的体素房间。由烧风制作。"
>
  <section class="hero vp-shell" aria-labelledby="hero-title">
    <div class="hero-intro">
      <div>
        <p class="project-name">体素池核</p>
        <h1 id="hero-title">下水看看。</h1>
      </div>
      <div class="hero-lead">
        <p>在浏览器里走进一座没人的泳池。潜下去看看瓷砖上的光，或者换一块玻璃，试试房间会变成什么颜色。</p>
        <div class="hero-actions">
          <a class="primary" href={links.play}>打开 VOXPOOL <span aria-hidden="true">↗</span></a>
          <a class="text-action" href={links.video}>看 B 站演示 <span aria-hidden="true">↗</span></a>
        </div>
        <p class="requirements">支持键鼠、触屏和手柄 · 需要 WebGPU</p>
      </div>
    </div>
    <figure class="hero-frame">
      <Image
        src={sunlitPool}
        alt="阳光照在白瓷砖柱上，柱廊倒映在青色水面"
        widths={[480, 720, 1040, 1440, 1920]}
        sizes="(min-width: 86rem) 78rem, 92vw"
        format="webp"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption><span>池边柱廊</span><span>VOXPOOL</span></figcaption>
    </figure>
  </section>

  <section class="observation vp-shell" aria-labelledby="light-title">
    <h2 id="light-title">留意墙上的光</h2>
    <p class="section-intro">光过了玻璃和水面以后，落到了哪里？</p>
    <fieldset class="views">
      <legend class="sr-only">选择观察视角</legend>
      <div class="view-options">
        {scenes.map((scene, index) => (
          <label class="view-option">
            <input type="radio" name="voxpool-view" value={scene.id} checked={index === 0} />
            <span>{scene.title}</span>
            <span class="view-arrow" aria-hidden="true">↗</span>
          </label>
        ))}
      </div>
      <div class="view-frames">
        {scenes.map((scene) => (
          <figure class="view-frame" data-view={scene.id}>
            <Image src={scene.image} alt={scene.alt} widths={[420, 720, 1040, 1440]} sizes="(min-width: 60rem) 64vw, 92vw" format="webp" />
            <figcaption>{scene.note}</figcaption>
          </figure>
        ))}
      </div>
    </fieldset>
  </section>

  <section class="workshop" aria-labelledby="edit-title">
    <div class="workshop-inner vp-shell">
      <div class="edit-copy">
        <h2 id="edit-title">动手改一块</h2>
        <p>切到自由模式，拆一格瓷砖，放一块会发光的方块。退远一点，看它照亮了哪面墙。想接着搭，可以把房间存成 <code>.vpool</code> 地图，下次再打开。</p>
        <dl class="edit-controls">
          <div><dt>键鼠</dt><dd><kbd>F</kbd> 切换自由模式，左键拆，右键放。</dd></div>
          <div><dt>触屏</dt><dd>切到自由模式，点按放置，长按拆除。</dd></div>
        </dl>
        <a class="text-action" href={links.play}>进场试试 <span aria-hidden="true">↗</span></a>
      </div>
      <figure class="film">
        <Bilibili bvid={links.videoId} title="烧风的 VOXPOOL 实机演示" />
        <figcaption>
          <span>烧风的 VOXPOOL 实机演示</span>
          <a href={links.video}>在 B 站打开 <span aria-hidden="true">↗</span></a>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="next vp-shell" aria-labelledby="next-title">
    <div class="map-spread">
      <figure>
        <Image
          src={dreamscape}
          alt="蓝色浅池分列走道两侧，成排顶灯倒映在水面"
          widths={[320, 480, 720, 1040, 1280]}
          sizes="(min-width: 86rem) 38rem, 46vw"
          format="webp"
        />
        <figcaption>池核 · 灯下的长廊</figcaption>
      </figure>
      <figure>
        <Image
          src={backrooms}
          alt="黄色走廊两侧开着门洞，成排的顶灯延伸到尽头"
          widths={[320, 480, 720, 1040, 1280]}
          sizes="(min-width: 86rem) 38rem, 46vw"
          format="webp"
        />
        <figcaption>后室 · 黄色走廊</figcaption>
      </figure>
    </div>
    <div class="next-intro">
      <h2 id="next-title">池边见。</h2>
      <p>池核之外，还有低矮的后室通道，以及一间用来观察颜色反弹的康奈尔盒。</p>
      <div class="next-actions">
        <a class="primary" href={links.play}>打开 VOXPOOL <span aria-hidden="true">↗</span></a>
        <a class="text-action" href={links.toy}>B 站 Toy <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="next-links">
      <div>
        <a href={links.paper}>技术白皮书 <span aria-hidden="true">↗</span></a>
        <p>改一块方块后，引擎重算了什么？含渲染路径、测量条件与复现实验。</p>
      </div>
      <div>
        <a href={links.email}>联系烧风 <span aria-hidden="true">↗</span></a>
        <p>想聊互动展览、场景合作，或了解项目的下一步，可以直接来信。</p>
      </div>
      <div>
        <a href={links.creator}>烧风的 B 站主页 <span aria-hidden="true">↗</span></a>
        <p>看开发演示，或在 <a href={links.support}>爱发电</a> 支持开发。</p>
      </div>
    </div>
  </section>
</VoxpoolLayout>

<style>
  h1, h2 {
    font-family: var(--vp-serif);
    font-weight: 800;
    letter-spacing: -0.075em;
    line-height: 1.12;
  }

  h1 { font-size: clamp(3.3rem, 9vw, 7.6rem); }
  h2 { font-size: clamp(2.4rem, 5vw, 4.1rem); }
  .project-name { font-size: 0.9rem; letter-spacing: 0.22em; font-weight: 700; color: var(--vp-accent); margin-block-end: 0.55rem; }

  .hero-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(20rem, 0.9fr);
    align-items: end;
    gap: 1.2rem 3rem;
    padding-block: clamp(2.55rem, 4vw, 3.8rem) clamp(1.55rem, 2.5vw, 2.3rem);
  }

  .hero-lead { max-inline-size: 29rem; padding-block-end: 0.2rem; }
  .hero-lead > p:first-child { font-size: clamp(1.05rem, 1.6vw, 1.23rem); line-height: 1.68; }
  .hero-actions, .next-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.55rem 1.25rem; margin-block-start: 1.15rem; }
  .primary, .text-action { display: inline-flex; align-items: center; gap: 0.6em; min-block-size: 2.75rem; font-weight: 700; }
  .primary {
    justify-content: space-between;
    padding: 0.6rem 1rem;
    min-inline-size: 9rem;
    background: var(--vp-ink);
    color: var(--vp-paper);
    text-decoration: none;
  }

  .primary:hover { background: var(--vp-accent); color: white; }
  .text-action { text-decoration-thickness: 1px; }
  .requirements { margin-block-start: 0.6rem; color: var(--vp-muted); font-size: 0.82rem; }

  .hero-frame img, .view-frame img, .map-spread img { inline-size: 100%; block-size: auto; object-fit: cover; background: #bad0c8; }
  .hero-frame img { aspect-ratio: 2.55; object-position: center bottom; }
  figcaption { color: var(--vp-muted); font-size: 0.875rem; margin-block-start: 0.55rem; }
  .hero-frame figcaption { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.1rem 1rem; }
  .hero-frame figcaption span:first-child { font-weight: 700; }

  .observation { padding-block: var(--vp-space); }
  .section-intro { margin-block: 0.8rem 1.8rem; max-inline-size: 32rem; }
  .views {
    display: grid;
    grid-template-columns: minmax(11rem, 0.7fr) minmax(0, 2.3fr);
    gap: 0.85rem clamp(1rem, 4vw, 3.8rem);
    min-inline-size: 0;
    padding: 0;
    margin: 0;
    border: 0;
  }

  .sr-only, .view-option input {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    padding: 0;
    margin: -1px;
    clip-path: inset(50%);
    overflow: hidden;
    white-space: nowrap;
    border: 0;
  }

  .view-options { border-block-start: 1px solid var(--vp-line); }
  .view-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.35rem;
    min-block-size: 3.8rem;
    border-block-end: 1px solid var(--vp-line);
    padding: 0.5rem 0.45rem 0.5rem 0;
    font-weight: 640;
    cursor: pointer;
  }

  .view-option:hover, .view-option:has(input:checked) { color: var(--vp-accent); }
  .view-option:has(input:checked) { font-weight: 800; border-block-end-color: currentColor; }
  .view-option:has(input:focus-visible) { outline: 2px solid var(--vp-accent); outline-offset: 3px; }
  .view-arrow { visibility: hidden; }
  .view-option:has(input:checked) .view-arrow { visibility: visible; }

  .view-frame { display: none; }
  .views:has([value="window"]:checked) [data-view="window"],
  .views:has([value="surface"]:checked) [data-view="surface"],
  .views:has([value="tunnel"]:checked) [data-view="tunnel"] { display: block; }

  .view-frame img { aspect-ratio: 1.9; }
  .view-frame figcaption { min-block-size: 3.3em; }

  .workshop {
    background: #16352f;
    color: #f3f2eb;
    padding-block: clamp(3rem, 7vw, 6rem);
  }

  .workshop-inner {
    display: grid;
    grid-template-columns: minmax(16rem, 0.9fr) minmax(0, 1.4fr);
    gap: clamp(1.6rem, 5vw, 5rem);
    align-items: center;
  }

  .edit-copy > p { margin-block: 0.9rem 1.4rem; max-inline-size: 27rem; }
  .edit-copy :is(kbd, code) { font-family: var(--vp-mono); font-size: 0.9em; }
  .edit-copy kbd { border: 1px solid #aec4b7; padding: 0.06em 0.33em; }
  .edit-controls { margin: 0 0 0.7rem; font-size: 0.875rem; color: #cee1d7; }
  .edit-controls div { display: grid; grid-template-columns: 2.75rem 1fr; gap: 0.35rem; border-block-start: 1px solid #57746a; padding: 0.55rem 0; }
  .edit-controls dt { font-weight: 720; }
  .edit-controls dd { margin: 0; }

  .workshop a:hover { color: #c6e6d5; }
  .workshop :focus-visible { outline-color: #c6e6d5; }
  .film { --bilibili-margin: 0; }
  .film figcaption { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 0.1rem 1rem; color: #cee1d7; }
  .film figcaption a { display: inline-flex; align-items: center; gap: 0.35em; min-block-size: 2.75rem; }

  .next {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2rem clamp(2rem, 8vw, 8rem);
    padding-block: var(--vp-space);
    align-items: start;
  }

  .map-spread {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.55rem, 2vw, 1.5rem);
  }

  .map-spread img { aspect-ratio: 4 / 3; }
  .next-intro > p { margin-block-start: 0.8rem; max-inline-size: 24rem; }
  .next-links > div { border-block-start: 1px solid var(--vp-line); padding: 0.8rem 0 1rem; }
  .next-links > div:last-child { border-block-end: 1px solid var(--vp-line); }
  .next-links > div > a { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; min-block-size: 2.75rem; font-weight: 730; text-decoration: none; }
  .next-links > div > a:hover { text-decoration: underline; }
  .next-links p { color: var(--vp-muted); font-size: 0.9rem; }

  @media (max-width: 52rem) {
    .hero-intro { grid-template-columns: 1fr; }
    .hero-frame img { aspect-ratio: 1.65; }
    .workshop-inner { grid-template-columns: 1fr; }
    .edit-copy { max-inline-size: 32rem; }
  }

  @media (max-width: 42rem) {
    .views, .next { grid-template-columns: 1fr; }
    .view-options { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-block-start: 0; }
    .view-option { justify-content: center; font-size: 0.875rem; min-block-size: 2.9rem; padding-inline: 0.1rem; text-align: center; }
    .view-arrow { display: none; }
    .view-frame img { aspect-ratio: 1.65; }
    .view-frame figcaption { min-block-size: 4.95em; }
  }

  @media (max-width: 25rem) {
    .hero-frame img { aspect-ratio: 1.25; }
  }

  @supports not selector(:has(*)) {
    .views { grid-template-columns: minmax(0, 1fr); }
    .view-options { display: none; }
    .view-frame { display: block; }
  }
</style>
